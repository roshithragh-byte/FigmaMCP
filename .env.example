# Figma Personal Access Token (required at runtime)
FIGMA_ACCESS_TOKEN=

# Server settings
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO

# Optional HTTP client tuning
FIGMA_API_BASE_URL=https://api.figma.com/v1
FIGMA_TIMEOUT_SECONDS=30.0
FIGMA_MAX_CONNECTIONS=20
FIGMA_MAX_KEEPALIVE_CONNECTIONS=10

# Google Cloud deployment variables (used by deploy.sh)
PROJECT_ID=
REGION=us-central1
SERVICE_NAME=figma-mcp-server
ARTIFACT_REPO=remote-mcp-servers
SECRET_NAME=figma-access-token
